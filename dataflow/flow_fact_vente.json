{
	"name": "flow_fact_vente",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ODS_ventes",
						"type": "DatasetReference"
					},
					"name": "ODSVENTE"
				},
				{
					"dataset": {
						"referenceName": "DS_DIM_enseigne",
						"type": "DatasetReference"
					},
					"name": "DIMENSEIGNE"
				},
				{
					"dataset": {
						"referenceName": "DS_DIM_produit",
						"type": "DatasetReference"
					},
					"name": "DIMPRODUIT"
				},
				{
					"dataset": {
						"referenceName": "DS_calendrier",
						"type": "DatasetReference"
					},
					"name": "DIMCALENDRIER"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_FACT_vente",
						"type": "DatasetReference"
					},
					"name": "FACTVENTE",
					"description": "Export data cleaned to DS_FACT_vente"
				}
			],
			"transformations": [
				{
					"name": "lookupVenteEnseigne",
					"description": "Lookup on 'ODSVENTE' from 'DIMENSEIGNE' to capture column enseignerowID from Dim_Enseigne"
				},
				{
					"name": "SelectColumnsEnseigneVente"
				},
				{
					"name": "lookupProduitVente"
				},
				{
					"name": "SelectColumnsProduitVente"
				},
				{
					"name": "lookupCalendrierVente"
				},
				{
					"name": "SelectColumnsCalendrierVente"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          IDVente as decimal(18,0),",
				"          Date_vente as date,",
				"          Reference_Produit as string,",
				"          Quantite as decimal(18,0),",
				"          Enseigne as string,",
				"          Prix_Total as decimal(18,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ODSVENTE",
				"source(output(",
				"          enseigne_rowid as integer,",
				"          enseigne as string,",
				"          ville as string,",
				"          adresse as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DIMENSEIGNE",
				"source(output(",
				"          produit_rowid as integer,",
				"          reference_produit as string,",
				"          nom as string,",
				"          prix as integer,",
				"          reference_categorie as string,",
				"          categorie as string,",
				"          description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DIMPRODUIT",
				"source(output(",
				"          idDate as integer,",
				"          Date_cal as date,",
				"          Year as integer,",
				"          Month as integer,",
				"          Day as integer,",
				"          Week as integer,",
				"          Quarter as integer,",
				"          DayOfWeek as integer,",
				"          DayName as string,",
				"          MonthName as string,",
				"          IsWeekend as boolean,",
				"          IsHoliday as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DIMCALENDRIER",
				"ODSVENTE, DIMENSEIGNE lookup(ODSVENTE@Enseigne == DIMENSEIGNE@enseigne,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupVenteEnseigne",
				"lookupVenteEnseigne select(mapColumn(",
				"          IDVente,",
				"          Date_vente,",
				"          Reference_Produit,",
				"          Quantite,",
				"          Prix_Total,",
				"          enseigne_rowid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectColumnsEnseigneVente",
				"SelectColumnsEnseigneVente, DIMPRODUIT lookup(SelectColumnsEnseigneVente@Reference_Produit == DIMPRODUIT@reference_produit,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupProduitVente",
				"lookupProduitVente select(mapColumn(",
				"          IDVente,",
				"          Date_vente,",
				"          Quantite,",
				"          Prix_Total,",
				"          enseigne_rowid,",
				"          produit_rowid",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectColumnsProduitVente",
				"SelectColumnsProduitVente, DIMCALENDRIER lookup(Date_vente == Date_cal,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupCalendrierVente",
				"lookupCalendrierVente select(mapColumn(",
				"          IDVente,",
				"          idDate,",
				"          produit_rowid,",
				"          enseigne_rowid,",
				"          Quantite,",
				"          Prix_Total",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectColumnsCalendrierVente",
				"SelectColumnsCalendrierVente alterRow(upsertIf(1==1)) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IDVente as integer,",
				"          idDate as integer,",
				"          produit_rowid as integer,",
				"          enseigne_rowid as integer,",
				"          quantite as integer,",
				"          Prix_Total as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['IDVente'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IDVente,",
				"          idDate,",
				"          produit_rowid,",
				"          enseigne_rowid,",
				"          quantite = Quantite,",
				"          Prix_Total",
				"     )) ~> FACTVENTE"
			]
		}
	}
}